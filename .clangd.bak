# Generated by scripts/setup-clangd.sh — re-run after toolchain/IDF updates.

CompileFlags:
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -fno-jump-tables
    - -mtext-section-literals
    - -mdisable-hardware-atomics
  Add:
    # Host clang is not Xtensa; without this, xtensa/config/core.h uses ../hal.h.
    - -D__XTENSA__
    - -isystem/home/mohy/.espressif/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/xtensa-esp-elf/include
    - -isystem/home/mohy/.espressif/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/picolibc/include
    - -isystem/home/mohy/work/esp/esp-idf/components/newlib/platform_include

---
If:
  PathMatch: .*/example/esp32-sync-http/.*
CompileFlags:
  CompilationDatabase: example/esp32-sync-http/build

---
If:
  PathMatch: .*/(include|src)/.*
CompileFlags:
  Add:
    - -I/home/mohy/work/keyhan/include
    - -I/home/mohy/work/keyhan/src
